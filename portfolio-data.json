    {
      "key": "hrPivotP",
      "label": "Hr💎P",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : ((prevWeekHigh + prevWeekLow + prevWeekClose) / 3).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "hrPivotR1",
      "label": "Hr💎R1",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : (2*hrPivotP - prevWeekLow).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "hrPivotR2",
      "label": "Hr💎R2",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : (hrPivotP + (prevWeekHigh-prevWeekLow)).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "hrPivotR3",
      "label": "Hr💎R3",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : (prevWeekHigh + 2*(hrPivotP-prevWeekLow)).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "hrPivotS1",
      "label": "Hr💎S1",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : (2*hrPivotP - prevWeekHigh).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "hrPivotS2",
      "label": "Hr💎S2",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : (hrPivotP - (prevWeekHigh-prevWeekLow)).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "hrPivotS3",
      "label": "Hr💎S3",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevWeekHigh || !prevWeekLow || !prevWeekClose) ? '-' : (prevWeekLow - 2*(prevWeekHigh-hrPivotP)).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "dayPivotP",
      "label": "Day💎P",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : ((prevMonthHigh + prevMonthLow + prevMonthClose) / 3).toFixed(2)",
      "agg": false,
      "hidden": false
    },
    {
      "key": "dayPivotR1",
      "label": "Day💎R1",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : (2*dayPivotP - prevMonthLow).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "dayPivotR2",
      "label": "Day💎R2",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : (dayPivotP + (prevMonthHigh-prevMonthLow)).toFixed(2)",
      "agg": false,
      "hidden": false
    },
    {
      "key": "dayPivotR3",
      "label": "Day💎R3",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : (prevMonthHigh + 2*(dayPivotP-prevMonthLow)).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "dayPivotS1",
      "label": "Day💎S1",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : (2*dayPivotP - prevMonthHigh).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "dayPivotS2",
      "label": "Day💎S2",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : (dayPivotP - (prevMonthHigh-prevMonthLow)).toFixed(2)",
      "agg": false,
      "hidden": false
    },
    {
      "key": "dayPivotS3",
      "label": "Day💎S3",
      "type": "calc",
      "resultType": "text",
      "formula": "(!prevMonthHigh || !prevMonthLow || !prevMonthClose) ? '-' : (prevMonthLow - 2*(prevMonthHigh-dayPivotP)).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "pivotTrend",
      "label": "Pivot",
      "type": "calc",
      "resultType": "text",
      "formula": "(!dayOpen || !dayPivotP) ? '-' : (dayOpen > dayPivotP ? (dayOpen > dayPivotR1 ? '🟩🟩' : '🟩') : (dayOpen < dayPivotP ? (dayOpen < dayPivotS1 ? '🟥🟥' : '🟥') : '-'))",
      "agg": false,
      "hidden": false
    },
    {
      "key": "dailyDistToCeiling",
      "label": "Daily Ceil %",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp||!dayPivotP) return '-'; var c=[dayPivotP,dayPivotR1,dayPivotR2,dayPivotR3].filter(function(v){return v&&v>ltp;}); if(!c.length) return '-'; var nr=Math.min.apply(null,c); return (((nr-ltp)/ltp)*100).toFixed(2); })()",
      "agg": false,
      "hidden": true
    },
    {
      "key": "dailyDistToFloor",
      "label": "Daily Floor %",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp||!dayPivotP) return '-'; var c=[dayPivotP,dayPivotS1,dayPivotS2,dayPivotS3].filter(function(v){return v&&v<ltp;}); if(!c.length) return '-'; var ns=Math.max.apply(null,c); return (((ltp-ns)/ltp)*100).toFixed(2); })()",
      "agg": false,
      "hidden": true
    },
    {
      "key": "weeklyDistToCeiling",
      "label": "Weekly Ceil %",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp||!hrPivotP) return '-'; var c=[hrPivotP,hrPivotR1,hrPivotR2,hrPivotR3].filter(function(v){return v&&v>ltp;}); if(!c.length) return '-'; var nr=Math.min.apply(null,c); return (((nr-ltp)/ltp)*100).toFixed(2); })()",
      "agg": false,
      "hidden": true
    },
    {
      "key": "weeklyDistToFloor",
      "label": "Weekly Floor %",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp||!hrPivotP) return '-'; var c=[hrPivotP,hrPivotS1,hrPivotS2,hrPivotS3].filter(function(v){return v&&v<ltp;}); if(!c.length) return '-'; var ns=Math.max.apply(null,c); return (((ltp-ns)/ltp)*100).toFixed(2); })()",
      "agg": false,
      "hidden": true
    },
    {
      "key": "mtsScore",
      "label": "MTS Score",
      "type": "calc",
      "formula": "(function(){ var s=0; if(dayPivotR1 && ltp>dayPivotR1) s+=2; else if(dayPivotP && ltp>dayPivotP) s+=1; else if(dayPivotS1 && ltp<dayPivotS1) s-=2; else if(dayPivotP && ltp<dayPivotP) s-=1; if(hrPivotR1 && ltp>hrPivotR1) s+=1; else if(hrPivotP && ltp>hrPivotP) s+=0.5; else if(hrPivotS1 && ltp<hrPivotS1) s-=1; else if(hrPivotP && ltp<hrPivotP) s-=0.5; return s; })()",
      "agg": false,
      "hidden": true
    },
    {
      "key": "mtsLabel",
      "label": "MTS",
      "type": "calc",
      "resultType": "text",
      "formula": "(mtsScore>=3?'Strong Bull':(mtsScore>=1?'Mild Bull':(mtsScore<=-3?'Strong Bear':(mtsScore<=-1?'Mild Bear':'Neutral'))))",
      "agg": false,
      "hidden": false
    },
    {
      "key": "runwayHr",
      "label": "Runway (Hr)",
      "type": "calc",
      "resultType": "text",
      "formula": "(!weeklyDistToCeiling || !weeklyDistToFloor) ? '-' : (weeklyDistToCeiling/weeklyDistToFloor).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "runwayDay",
      "label": "Runway (Day)",
      "type": "calc",
      "resultType": "text",
      "formula": "(!dailyDistToCeiling || !dailyDistToFloor) ? '-' : (dailyDistToCeiling/dailyDistToFloor).toFixed(2)",
      "agg": false,
      "hidden": true
    },
    {
      "key": "screenerSignal",
      "label": "Signal",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp) return '-'; if(mtsScore>=3){ if(runwayDay>=2 && dailyDistToCeiling>1.5 && weeklyDistToCeiling>0) return '🚀 Strong Buy'; if(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5) return '⚠️ Trap/No-Trade'; return '🔼 Building Bullish'; } if(mtsScore>=1){ if(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5) return '⚠️ Trap/No-Trade'; return '🔼 Building Bullish'; } if(mtsScore>-1){ if(((dailyDistToCeiling>0 && dailyDistToCeiling<1) || (dailyDistToFloor>0 && dailyDistToFloor<1)) && ((weeklyDistToCeiling>0 && weeklyDistToCeiling<1) || (weeklyDistToFloor>0 && weeklyDistToFloor<1))) return '🌀 Squeeze/Coiling'; return '⚪ Neutral'; } if(mtsScore>-3){ if(dailyDistToFloor>0 && dailyDistToFloor<1 && weeklyDistToFloor>2) return '🪤 Bear Trap Risk'; return '🔽 Building Bearish'; } if(runwayDay>=2 && dailyDistToFloor>1.5 && weeklyDistToFloor>0) return '📉 Strong Sell'; return '🔽 Building Bearish'; })()",
      "agg": false,
      "hidden": false
    },
    {
      "key": "signalAction",
      "label": "🟢🟡🔴",
      "type": "mirror",
      "sourceKey": "screenerSignal",
      "fallback": "HOLD",
      "map": {
        "🚀 Strong Buy": "STRONG BUY",
        "🔼 Building Bullish": "BUY",
        "⚠️ Trap/No-Trade": "HOLD",
        "🌀 Squeeze/Coiling": "HOLD",
        "⚪ Neutral": "HOLD",
        "🪤 Bear Trap Risk": "HOLD",
        "🔽 Building Bearish": "SELL",
        "📉 Strong Sell": "STRONG SELL"
      },
      "agg": false,
      "hidden": false
    },
    {
      "key": "targetPrice",
      "label": "📌arget",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp || !dayPivotP) return '-'; var isBuy=false, isSell=false; if(mtsScore>=3){ if(!(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5)) isBuy=true; } else if(mtsScore>=1){ if(!(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5)) isBuy=true; } else if(mtsScore>-1){ } else if(mtsScore>-3){ if(!(dailyDistToFloor>0 && dailyDistToFloor<1 && weeklyDistToFloor>2)) isSell=true; } else { isSell=true; } if(isBuy){ if(ltp>=dayPivotR3) return 'Beyond R3'; if(ltp>=dayPivotR2) return dayPivotR3; if(ltp>=dayPivotR1) return dayPivotR2; return dayPivotR1; } if(isSell){ if(ltp<=dayPivotS3) return 'Beyond S3'; if(ltp<=dayPivotS2) return dayPivotS3; return dayPivotS2; } return '-'; })()",
      "agg": false,
      "hidden": false
    },
    {
      "key": "alertPrice",
      "label": "🔔lert",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp || !dayPivotP) return '-'; var isBuy=false, isSell=false; if(mtsScore>=3){ if(!(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5)) isBuy=true; } else if(mtsScore>=1){ if(!(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5)) isBuy=true; } else if(mtsScore>-1){ } else if(mtsScore>-3){ if(!(dailyDistToFloor>0 && dailyDistToFloor<1 && weeklyDistToFloor>2)) isSell=true; } else { isSell=true; } return (isBuy||isSell) ? dayPivotP : '-'; })()",
      "agg": false,
      "hidden": false
    },
    {
      "key": "watchLevel",
      "label": " ⏰ ",
      "type": "calc",
      "resultType": "text",
      "formula": "(function(){ if(!ltp || !hrPivotP) return '-'; var isTrap=false, isBearTrap=false, isSqueeze=false; if(mtsScore>=3){ if(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5) isTrap=true; } else if(mtsScore>=1){ if(dailyDistToCeiling>2 && weeklyDistToCeiling>0 && weeklyDistToCeiling<0.5) isTrap=true; } else if(mtsScore>-1){ if(((dailyDistToCeiling>0 && dailyDistToCeiling<1) || (dailyDistToFloor>0 && dailyDistToFloor<1)) && ((weeklyDistToCeiling>0 && weeklyDistToCeiling<1) || (weeklyDistToFloor>0 && weeklyDistToFloor<1))) isSqueeze=true; } else if(mtsScore>-3){ if(dailyDistToFloor>0 && dailyDistToFloor<1 && weeklyDistToFloor>2) isBearTrap=true; } function nearestCeiling(){ if(ltp>=hrPivotR3) return 'Beyond Hr R3'; if(ltp>=hrPivotR2) return hrPivotR3; if(ltp>=hrPivotR1) return hrPivotR2; if(ltp>=hrPivotP) return hrPivotR1; return hrPivotP; } function nearestFloor(){ if(ltp<=hrPivotS3) return 'Beyond Hr S3'; if(ltp<=hrPivotS2) return hrPivotS3; if(ltp<=hrPivotS1) return hrPivotS2; if(ltp<=hrPivotP) return hrPivotS1; return hrPivotP; } if(isTrap) return nearestCeiling(); if(isBearTrap) return nearestFloor(); if(isSqueeze) return (weeklyDistToCeiling<=weeklyDistToFloor) ? nearestCeiling() : nearestFloor(); return '-'; })()",
      "agg": false,
      "hidden": false
    },
