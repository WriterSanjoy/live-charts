    {
      "key": "pivotP",
      "label": "Pivot P",
      "type": "calc",
      "formula": "(!prevHigh || !prevLow) ? '-' : ((prevHigh + prevLow + prevClose) / 3).toFixed(2)",
      "agg": false,
      "hidden": true,
      "resultType": "text"
    },
    {
      "key": "pivotR1",
      "label": "Pivot R1",
      "type": "calc",
      "formula": "(!prevHigh || !prevLow) ? '-' : (pivotP + 0.382*(prevHigh-prevLow)).toFixed(2)",
      "agg": false,
      "hidden": true,
      "resultType": "text"
    },
    {
      "key": "pivotR2",
      "label": "Pivot R2",
      "type": "calc",
      "formula": "(!prevHigh || !prevLow) ? '-' : (pivotP + 0.618*(prevHigh-prevLow)).toFixed(2)",
      "agg": false,
      "hidden": true,
      "resultType": "text"
    },
    {
      "key": "pivotS1",
      "label": "Pivot S1",
      "type": "calc",
      "formula": "(!prevHigh || !prevLow) ? '-' : (pivotP - 0.382*(prevHigh-prevLow)).toFixed(2)",
      "agg": false,
      "hidden": true,
      "resultType": "text"
    },
    {
      "key": "pivotS2",
      "label": "Pivot S2",
      "type": "calc",
      "formula": "(!prevHigh || !prevLow) ? '-' : (pivotP - 0.618*(prevHigh-prevLow)).toFixed(2)",
      "agg": false,
      "hidden": true,
      "resultType": "text"
    },
    {
      "key": "pivotTrend",
      "label": "Pivot",
      "type": "calc",
      "resultType": "text",
      "formula": "(!dayOpen || !pivotP) ? '-' : (dayOpen > pivotP ? (dayOpen > pivotR1 ? '🟩🟩' : '🟩') : (dayOpen < pivotP ? (dayOpen < pivotS1 ? '🟥🟥' : '🟥') : '-'))",
      "agg": false,
      "hidden": false
    },
    {
